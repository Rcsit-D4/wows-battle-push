{
  "manifest_version": 2,
  "version": "1.1.0",
  "id": "wows-battle-push",
  "name": "战舰世界战绩推送",
  "description": "监控《战舰世界》账号对局，检测到新战绩结算时自动推送到绑定群。数据源为 Vortex 公共接口",
  "author": {
    "name": "Rcsit",
    "url": "https://github.com/wows-yuyuko/wows-real"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/wows-yuyuko/wows-real",
    "documentation": "https://docs.mai-mai.org/plugin/"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "9.99.99"
  },
  "sdk": {
    "min_version": "1.0.0",
    "max_version": "9.99.99"
  },
  "plugin_type": "integration",
  "capabilities": [
    "send_message",
    "send.text",
    "send.image",
    "render.html2png"
  ],
  "i18n": {
    "default_locale": "zh-CN"
  }
}
